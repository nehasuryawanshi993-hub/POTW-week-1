//2.Successful Pairs of Spells and Potions
class Solution {

    //ti,e complexity=O(nlogn)
    public int[] successfulPairs(int[] spells, int[] potions, long success) {
        int n=spells.length;
        int m=potions.length;
        int[] ans=new int[n];
        
        Arrays.sort(potions);
        for(int i=0;i<n;i++){
            int low=0;
        int high=m-1;
            int cnt=0;
           while(low<=high){
            int mid=low+(high-low)/2;
                if((long)spells[i]*potions[mid]>=success){
                    cnt=0;
                    cnt+=(m-mid);
               high=mid-1;
                }
                else{
                    low=mid+1;
                }
            }
            
            ans[i]=cnt;
        }
        return ans;
    }
}
