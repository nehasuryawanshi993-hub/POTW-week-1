//Add digits
class Solution {
public:
    int addDigits(int num) {
        int sum=0;
        int ans=0;
        while(num!=0){
      while(num!=0){
        int rem=num%10;
sum+=rem;
        num/=10;
      } 
      num=sum; 
      if(sum/10==0){
        ans=sum;
        break;
      }
      sum=0;
        }
      return ans;
    }
};
//Water Bottles
class Solution {
    public int numWaterBottles(int numBottles, int numExchange) {
     int total=numBottles;
     while(numBottles/numExchange!=0){
int rem=numBottles%numExchange;
int ans=numBottles/numExchange;
total+=ans;

numBottles=ans+rem;
     }  
     return total; 
    }
}
