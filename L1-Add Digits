class Solution {
public:
    int addDigits(int num) {
        int sum=0;
        int ans=0;
        while(num!=0){
      while(num!=0){
        int rem=num%10;
sum+=rem;
        num/=10;
      } 
      num=sum; 
      if(sum/10==0){
        ans=sum;
        break;
      }
      sum=0;
        }
      return ans;
    }
};
