//1.Check if N and its Digits Exist
class Solution {
    //time complexity=O(nlogn)
    public boolean checkIfExist(int[] arr) {
    int n=arr.length;
    Arrays.sort(arr);
    for(int i=0;i<n;i++){
        int k=arr[i];
        int low=0;
        int high=n-1;
        while(low<=high){
            int mid=low+(high-low)/2;
            if(2*arr[mid]==k && i!=mid){
                return true;
            }
            if(2*arr[mid]<k){
                low=mid+1;
            }
            else{
                high=mid-1;
            }
        }
    }
    return false;
    }
}

//2.Maximum Difference Between Adjacent Elements in a
Circular Array
class Solution {
    public int maxAdjacentDistance(int[] nums) {
        int n=nums.length;
        int maxi=0;
        for(int i=1;i<n;i++){
            maxi=Math.max(maxi,Math.abs(nums[i]-nums[i-1]));
        }
        maxi=Math.max(maxi,Math.abs(nums[0]-nums[n-1]));
        return maxi;
    }
}
